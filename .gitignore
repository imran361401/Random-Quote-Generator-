import tkinter as tk
from tkinter import messagebox, ttk
import random
import json
import os

class QuoteApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Random Quote Generator")
        self.root.geometry("600x500")

        # Данные
        self.file_path = "quotes.json"
        self.all_quotes = [
            {"text": "Жизнь — это то, что случается, пока вы строите планы.", "author": "Джон Леннон", "theme": "Жизнь"},
            {"text": "Успех — это идти от ошибки к ошибке без потери энтузиазма.", "author": "Уинстон Черчилль", "theme": "Успех"},
            {"text": "Сложнее всего начать действовать, остальное зависит только от упорства.", "author": "Амелия Эрхарт", "theme": "Мотивация"}
        ]
        self.history = []
        self.load_data()

        # Интерфейс
        self.setup_ui()

    def setup_ui(self):
        # Область цитаты
        self.lbl_quote = tk.Label(self.root, text="Нажмите кнопку для получения цитаты", wraplength=500, font=("Arial", 12, "italic"))
        self.lbl_quote.pack(pady=20)

        self.btn_generate = tk.Button(self.root, text="Сгенерировать цитату", command=self.generate_quote, bg="#4CAF50", fg="white")
        self.btn_generate.pack(pady=5)

        # Фильтры
        filter_frame = tk.Frame(self.root)
        filter_frame.pack(pady=10)

        tk.Label(filter_frame, text="Фильтр (Автор/Тема):").grid(row=0, column=0)
        self.entry_filter = tk.Entry(filter_frame)
        self.entry_filter.grid(row=0, column=1, padx=5)
        
        tk.Button(filter_frame, text="Применить", command=self.update_history_display).grid(row=0, column=2)

        # История
        tk.Label(self.root, text="История:").pack()
        self.history_list = tk.Listbox(self.root, width=70, height=10)
        self.history_list.pack(pady=5, padx=10)

    def generate_quote(self):
        quote = random.choice(self.all_quotes)
        display_text = f"«{quote['text']}» — {quote['author']}"
        self.lbl_quote.config(text=display_text)
        
        # Добавление в историю
        self.history.append(quote)
        self.save_data()
        self.update_history_display()

    def update_history_display(self):
        self.history_list.delete(0, tk.END)
        filter_query = self.entry_filter.get().lower()

        for q in self.history:
            if filter_query in q['author'].lower() or filter_query in q['theme'].lower():
                self.history_list.insert(tk.END, f"[{q['theme']}] {q['author']}: {q['text'][:40]}...")

    def save_data(self):
        with open(self.file_path, 'w', encoding='utf-8') as f:
            json.dump(self.history, f, ensure_ascii=False, indent=4)

    def load_data(self):
        if os.path.exists(self.file_path):
            with open(self.file_path, 'r', encoding='utf-8') as f:
                self.history = json.load(f)

if __name__ == "__main__":
    root = tk.Tk()
    app = QuoteApp(root)
    root.mainloop()
